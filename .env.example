# Copy to .env and adjust. Never commit .env.

# --- Paths -------------------------------------------------------------------
DATA_DIR=data

# --- Open Library ingestion ------------------------------------------------------
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
# Open Library asks API clients to send an identifying User-Agent with contact info.
HTTP_USER_AGENT=distributed-book-pricing-analytics/0.1 (contact: you@example.com)
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
# Max works fetched per subject.
INGEST_LIMIT=50

# --- Demo observation generator -------------------------------------------------
# Fixed seed => identical simulated observations for identical input.
DEMO_RANDOM_SEED=42

# --- Spark -------------------------------------------------------------------------
# Unset => spark-submit decides (default local[*]); set only to force a master.
# SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=4

# --- PostgreSQL (local Docker Compose defaults; not real credentials) ------------
# Host-side port of the Compose PostgreSQL (bound to 127.0.0.1). Containers use 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=book_analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me-local-only

LOG_LEVEL=INFO
